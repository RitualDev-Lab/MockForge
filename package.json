{
  "name": "@ritualdev-lab/mockforge",
  "version": "0.1.0",
  "description": "Enterprise Intelligent Relational Mock DB & Synthetic Test Data Engine (Postgres/MySQL/SQLite/Prisma)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mockforge": "bin/mockforge.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RitualDev-Lab/MockForge.git"
  },
  "homepage": "https://ritualdev.in/mockforge",
  "scripts": {
    "dev": "vite src/ui",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mock-database",
    "synthetic-data",
    "relational-generator",
    "test-fixtures",
    "postgres",
    "mysql",
    "sqlite",
    "prisma",
    "kahn-dag"
  ],
  "author": "RitualDev Studio <engineering@ritualdev.in>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
